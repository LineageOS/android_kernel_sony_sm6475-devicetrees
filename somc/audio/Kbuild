DTC_INCLUDE += $(srctree)/../sm6475-modules/qcom/opensource/audio-kernel/include

dtbo-y += elbe-audio.dtbo

quiet_cmd_copy_dtbo = COPY    $@
      cmd_copy_dtbo = mkdir -p $(dir $@) && cp -f $< $@

targets += ../../qcom/audio/elbe-audio.dtbo

$(obj)/../../qcom/audio/elbe-audio.dtbo: $(obj)/elbe-audio.dtbo FORCE
	$(call if_changed,copy_dtbo)

always-y	:= $(dtb-y) $(dtbo-y) ../../qcom/audio/elbe-audio.dtbo
subdir-y	:= $(dts-dirs)
clean-files	:= *.dtb *.dtbo
